# ─────────────────────────────────────────────────────────────
# Purs & Gold website · environment variables
# Paste real values into .env.local (never committed).
# Set the same names in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Neon Postgres ────────────────────────────────────────────
# From Neon → Project → Connection details (or the Vercel Neon integration).
# Pooled connection (use in the app):
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection, used only by drizzle-kit for migrations:
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ── Resend (transactional email) ────────────────────────────
# Resend → API Keys → Create. Verify the domain pursandgold.com.ng under Resend → Domains first.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Inbox that receives new leads and discovery-call requests:
LEADS_TO_EMAIL=info@pursandgold.com.ng
# Sender shown on notifications (must be on the verified domain):
LEADS_FROM_EMAIL="Purs & Gold Website <no-reply@pursandgold.com.ng>"

# ── Site ────────────────────────────────────────────────────
# Canonical URL for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.pursandgold.com.ng
