# ─────────────────────────────────────────────────────────────
# Purs & Gold website · environment variables
# Paste real values into .env.local (never committed).
# Set the same names in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Neon Postgres ────────────────────────────────────────────
# From Neon → Project → Connection details (or the Vercel Neon integration).
# Pooled connection (use in the app):
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection, used only by drizzle-kit for migrations:
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ── Resend (transactional email) ────────────────────────────
# Resend → API Keys → Create. Verify the domain pursandgold.com.ng under Resend → Domains first.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Inbox that receives new leads and discovery-call requests:
LEADS_TO_EMAIL=info@pursandgold.com.ng
# Sender shown on notifications (must be on the verified domain):
LEADS_FROM_EMAIL="Purs & Gold Website <no-reply@pursandgold.com.ng>"

# ── Site ────────────────────────────────────────────────────
# Canonical URL for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.pursandgold.com.ng

# ── Purs Pay (central payments service, /api/pay/*) ──────────
# ONE deployment and ONE database serve both Paystack modes. Both Paystack webhook URLs
# (Settings → API Keys & Webhooks → Test/Live Webhook URL) point at the same endpoint;
# each event is verified against the key that signed it and stored with its mode.
#
# Mode used for NEW checkouts. Leave empty to use live when a live key is set, else test.
# Set PAYSTACK_MODE=test to keep testing after the live keys are in place.
PAYSTACK_MODE=
# Secret keys: Paystack dashboard → Settings → API Keys & Webhooks. Never commit real values.
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_TEST_WEBHOOK_URL=https://www.pursandgold.com.ng/api/pay/webhooks/paystack
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_WEBHOOK_URL=https://www.pursandgold.com.ng/api/pay/webhooks/paystack
# Public keys are not used server-side (customers pay on Paystack's hosted page, not inline JS).
PAYSTACK_TEST_PUBLIC_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=
# Reserved for website-owned checkouts. Purs Pay products pass their own callbackUrl.
PAYSTACK_CALLBACK_URL=

# Shared secret for the retry job (/api/pay/jobs/retry). Vercel Cron sends it as a Bearer token. Generate: openssl rand -hex 32
CRON_SECRET=

# One block per product. Slugs: TENAVILLE, VERITORY, PURSBERRY, PURSEDU.
#   _KEY            bearer key the product uses to call Purs Pay          (openssl rand -hex 32)
#   _WEBHOOK_URL    where Purs Pay delivers signed events to the product
#   _WEBHOOK_SECRET HMAC secret for those events; the product verifies with it   (openssl rand -hex 32, different from _KEY)
#   _ORIGINS        comma separated origins the product may use as Paystack callback_url
PAY_APP_TENAVILLE_KEY=
PAY_APP_TENAVILLE_WEBHOOK_URL=https://tenaville.com.ng/api/webhooks/payments/purs-pay
PAY_APP_TENAVILLE_WEBHOOK_SECRET=
PAY_APP_TENAVILLE_ORIGINS=https://tenaville.com.ng,https://www.tenaville.com.ng

PAY_APP_VERITORY_KEY=
PAY_APP_VERITORY_WEBHOOK_URL=https://command.veritory.com.ng/api/webhooks/purs-pay
PAY_APP_VERITORY_WEBHOOK_SECRET=
PAY_APP_VERITORY_ORIGINS=https://command.veritory.com.ng,https://veritory.com.ng,https://www.veritory.com.ng

PAY_APP_PURSBERRY_KEY=
PAY_APP_PURSBERRY_WEBHOOK_URL=https://api.pursberry.com/webhooks/billing/purs-pay
PAY_APP_PURSBERRY_WEBHOOK_SECRET=
PAY_APP_PURSBERRY_ORIGINS=https://app.pursberry.com,https://admin.pursberry.com,https://suite.pursberry.com,https://pos.pursberry.com,https://www.pursberry.com,https://pursberry.com

PAY_APP_PURSEDU_KEY=
PAY_APP_PURSEDU_WEBHOOK_URL=https://pursedu.com.ng/api/v1/webhooks/purs-pay
PAY_APP_PURSEDU_WEBHOOK_SECRET=
PAY_APP_PURSEDU_ORIGINS=https://pursedu.com.ng,https://www.pursedu.com.ng
